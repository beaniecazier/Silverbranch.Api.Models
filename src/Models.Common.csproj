<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TimeStamp></TimeStamp>
  </PropertyGroup>
  
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <UseMauiEssentials>false</UseMauiEssentials>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <Company>Silverbranch Codeworks</Company>
    <Authors>Tiabeanie Cazier</Authors>
    <Product>$(Company) API Base Models</Product>
    <Title>$(Product)</Title>
    <AssemblyName>Api.Models</AssemblyName>
    <RootNamespace>Gay.Silverbranch.$(AssemblyName)</RootNamespace>
    <PackageId>Gay.Silverbranch.pkg.$(AssemblyName)</PackageId>
    <PackageProjectUrl>silverbranch-codeworks.com</PackageProjectUrl>
    <!--    <RepositoryUrl></RepositoryUrl>-->

    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <PackageVersion>$(VersionPrefix)$(VersionSuffix)$(TimeStamp)</PackageVersion>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>

    <PackageReleaseNotes># SILVERBRANCH CODEWORKS COMMON MODELS

      ## Version [1.0.0-alpha] - 2025-07-20

      **Type:** Alpha
      **Stability:** ⚠️ Experimental – Not recommended for production use.

      ---

      ### 🚧 Overview

      This alpha release introduces early implementations of planned features for version 1.0.0.

      > ⚠️ APIs and behavior may change without notice in future builds.

      > 💡 Use this release to explore upcoming features and provide feedback.

      ---

      ### ➕ New Features ➕

      - ModelDocumentation Attribute has been renamed and its properties now use the enum values and better represent the metadata
      - Extended the list of modifer Enum types and values

      ---

      ### ⚠️ Known Issues / Limitations ️⚠️

      - [ ] PropertyMetaInfo related enums are still in flux and need to be nailed down

      ---

      ### 🔗 Related Links 🔗

      - [Full Changelog](CHANGELOG.md#Version-100-alpha)
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>Icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\ReleaseNotes.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>ReleaseNotes.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Gay.Silverbranch.pkg.Utilities.General" Version="1.0.0-alpha-20250823-020030" />
    <PackageReference Include="LanguageExt.Core" Version="5.0.0-beta-54" />
    <PackageReference Include="Nanoid" Version="3.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="8.1.1" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Events\V1\" />
    <Folder Include="ValueObjects\V1\" />
  </ItemGroup>
  
</Project>