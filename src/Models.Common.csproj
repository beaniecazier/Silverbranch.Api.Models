<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <UseMauiEssentials>false</UseMauiEssentials>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <Company>Silverbranch Codeworks</Company>
    <Authors>Tiabeanie Cazier</Authors>
    <Product>$(Company) API Base Models</Product>
    <Title>$(Product)</Title>
    <AssemblyName>Api.Models</AssemblyName>
    <RootNamespace>Gay.Silverbranch.API.Models</RootNamespace>
    <PackageId>Gay.Silverbranch.pkg.$(AssemblyName)</PackageId>
    <VersionPrefix>1.1.0</VersionPrefix>
    <VersionSuffix>alpha-$([System.DateTime]::UtcNow.ToString("yyyyMMdd-HHmmss"))</VersionSuffix>
    <PackageProjectUrl>silverbranch-codeworks.com</PackageProjectUrl>
    <!--    <RepositoryUrl></RepositoryUrl>-->

    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>

    <PackageReleaseNotes>
      Version 1.1.0-alpha
      ----------------------------------------------------------------
      notes here
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>Icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\ReleaseNotes.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>ReleaseNotes.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Gay.Silverbranch.pkg.Utilities.General" Version="1.0.0-alpha-20250701-013653" />
    <PackageReference Include="LanguageExt.Core" Version="5.0.0-beta-54" />
    <PackageReference Include="Nanoid" Version="3.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="8.1.1" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Events\V1\" />
  </ItemGroup>
  
</Project>